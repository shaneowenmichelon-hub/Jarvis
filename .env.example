# Copy to .env.local for local development. In production these live in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase -------------------------------------------------------------
# Project Settings → API. The service-role key bypasses row level security and
# must never be exposed to the browser: no NEXT_PUBLIC_ prefix, ever.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---------------------------------------------------------
# One OAuth client in Google Cloud covers both sign-in and Gmail reading.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who gets in ----------------------------------------------------------
# Comma-separated. These addresses also count as "us" when the scan decides
# whether a message was inbound or outbound.
ALLOWED_EMAILS=shane@zmmevents.com,zach@zmmevents.com

# Optional: let anyone on the agency domain sign in without listing them.
ALLOWED_DOMAIN=zmmevents.com

# Optional: domains you own, so internal mail is never read as a submission.
# Defaults to ALLOWED_DOMAIN when left blank.
OWN_DOMAINS=

# Optional: extra send-as aliases that should count as outbound.
OWN_ADDRESSES=

# --- Website form intake ---------------------------------------------------
# This is the front door. A brand gets on the board because it came through the
# form at collegiateagency.com, which lands in the inbox as a notification from
# the address below. Nothing a stranger emails directly creates a card.
#
# If the site's sending address ever changes, change it here or the board
# quietly stops filling. Comma-separate for more than one.
FORM_SENDER=no-reply@zmmevents.com

# Subject phrase that marks a brand submission. The sender alone is not enough:
# ambassador applications arrive from the same address, and those are people
# applying to work campus, not brands buying.
FORM_SUBJECT_MATCH=brand inquiry

# Where leads may come from:
#   form_only         the form is the only way onto the board (default)
#   form_and_inbound  a brand that emails in cold also creates a card
# Switch to form_and_inbound if leads start arriving another way.
INTAKE_MODE=form_only

# --- Cron -----------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -hex 32
# Guards /api/cron/scan, which is otherwise open to the internet.
CRON_SECRET=

# --- Optional: brand-name extraction --------------------------------------
# Without this the scan still works — new brands just land marked "unverified"
# for someone to confirm, named after their domain.
ANTHROPIC_API_KEY=

# --- Tuning ---------------------------------------------------------------
# How far back the very first scan reaches.
SCAN_BACKFILL_DAYS=180
# Ceiling on threads read per run.
SCAN_THREAD_LIMIT=400

# --- Deployment -----------------------------------------------------------
# Only needed locally; Vercel supplies its own URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
