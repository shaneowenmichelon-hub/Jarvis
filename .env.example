# ZMM // SPONSOR COMMAND — environment config
# Copy this to .env and fill in your values. Do NOT commit .env.

# ---- Server ----
PORT=3001
PUBLIC_URL=http://localhost:3001

# ---- Google OAuth (Gmail) ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match PUBLIC_URL + /auth/google/callback
# Required scope: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ---- Anthropic (JARVIS chat) ----
# Optional. Without this, the chat falls back to simulated mode.
ANTHROPIC_API_KEY=

# ---- Sync ----
# Minimum seconds between Gmail syncs (rate limit). Default 30.
SYNC_MIN_INTERVAL=30
